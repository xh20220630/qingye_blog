# Use http://your-public-ip without a domain, or https://your-domain for automatic HTTPS.
SITE_URL=https://blog.example.com
# The values below are only used when running the Node service directly.
HOST=127.0.0.1
PORT=4324
# Defaults to a private directory under the current user's home.
# QY_DATA_DIR=D:/qingye-data
# QY_STATIC_DIR=D:/qingye-release
# Enable only behind a reverse proxy that overwrites X-Forwarded-Proto.
QY_TRUST_PROXY=false
