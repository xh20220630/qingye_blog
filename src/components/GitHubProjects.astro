---
import github from '@/data/github.json'

const dateFormat = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Shanghai',
})
const repositories = [...github.repositories].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt))
---

<section aria-labelledby="github-projects-heading" class="mt-10 lg:mt-12">
  <div class="mb-1 flex items-baseline gap-3">
    <h2 id="github-projects-heading" class="text-5 c-primary font-semibold tracking-wide lg:text-5.5">公开项目</h2>
    <span class="text-3.5 c-secondary/60">{repositories.length} 个仓库</span>
  </div>

  <ul class="m-0 list-none p-0">
    {repositories.map(repo => (
      <li class="border-b border-secondary/15 py-6 last:border-b-0">
        <a
          href={repo.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`在 GitHub 查看 ${repo.name}`}
          class="group block rounded-sm focus-visible:(outline-2 outline-primary outline-offset-4 outline)"
        >
          <div class="flex items-start justify-between gap-4">
            <h3 class="min-w-0 break-words text-4.5 c-primary font-semibold leading-1.5em lg:text-5">
              <span class="highlight-hover">{repo.name}</span>
            </h3>
            <span aria-hidden="true" class="shrink-0 text-4 c-secondary/60 transition-transform group-hover:(translate-x-0.5 translate-y--0.5 c-primary)">↗</span>
          </div>

          <p class="mb-3 mt-2 break-words text-3.5 c-secondary leading-1.8em lg:text-4">
            {repo.description || '暂无项目简介。'}
          </p>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-3 c-secondary/65 leading-1.8em lg:text-3.25">
            {repo.language && <span>{repo.language}</span>}
            {repo.stars > 0 && <span aria-label={`${repo.stars} 个 Star`}>☆ {repo.stars}</span>}
            {repo.archived && <span>已归档</span>}
            <span>更新于 <time datetime={repo.updatedAt}>{dateFormat.format(new Date(repo.updatedAt))}</time></span>
            {repo.isFork && <span class="min-w-0 break-all">Fork · {repo.source}</span>}
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
