---
// ImmortalMist · 全屏天空白云背景（离线云朵纹理版）
// 采样 tools/render_clouds.py 预渲染的 RGBA 云纹理
// 骨架保留：0.55x 内部分辨率 / 30fps 节流 / GSAP 视差 / 粒子 / 静态帧降级
---
<canvas id="immortal-mist" aria-hidden="true"></canvas>

<style>
  #immortal-mist {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const canvas = document.getElementById('immortal-mist');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    || document.documentElement.dataset.motion === 'off';

  let renderer = null;
  try {
    renderer = new THREE.WebGLRenderer({ canvas, antialias: false, alpha: false, powerPreference: 'low-power' });
  } catch (e) {
    renderer = null;
  }

  if (!renderer) {
    document.documentElement.classList.add('no-webgl');
    canvas.remove();
  } else {
    const RENDER_SCALE = 0.55;
    const effRatio = Math.min(window.devicePixelRatio || 1, 1.5) * RENDER_SCALE;
    renderer.setPixelRatio(effRatio);
    renderer.setSize(window.innerWidth, window.innerHeight, false);

    /* ---------- 256x256 可平铺噪声纹理（仅用于远山脊线与光缕） ---------- */
    function makeNoiseTexture() {
      const S = 256;
      const data = new Uint8Array(S * S * 4);
      const chan = (lattice: number, seedInit: number) => {
        const g = lattice;
        const vals = new Float32Array(g * g);
        let s = seedInit >>> 0;
        const rnd = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
        for (let i = 0; i < g * g; i++) vals[i] = rnd();
        const out = new Float32Array(S * S);
        const sm = (t: number) => t * t * (3 - 2 * t);
        for (let y = 0; y < S; y++) {
          for (let x = 0; x < S; x++) {
            const fx = (x / S) * g, fy = (y / S) * g;
            const ix = Math.floor(fx) % g, iy = Math.floor(fy) % g;
            const tx = sm(fx - Math.floor(fx)), ty = sm(fy - Math.floor(fy));
            const i2 = (ix + 1) % g, j2 = (iy + 1) % g;
            const a = vals[iy * g + ix], b = vals[iy * g + i2];
            const c = vals[j2 * g + ix], d = vals[j2 * g + i2];
            out[y * S + x] = a + (b - a) * tx + (c - a) * ty + (a - b - c + d) * tx * ty;
          }
        }
        return out;
      };
      const r = chan(32, 1234567), g = chan(32, 7654321), b = chan(16, 987654), a = chan(8, 456789);
      for (let i = 0; i < S * S; i++) {
        data[i * 4] = r[i] * 255;
        data[i * 4 + 1] = g[i] * 255;
        data[i * 4 + 2] = b[i] * 255;
        data[i * 4 + 3] = a[i] * 255;
      }
      const tex = new THREE.DataTexture(data, S, S, THREE.RGBAFormat);
      tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
      tex.magFilter = THREE.LinearFilter;
      tex.minFilter = THREE.LinearFilter;
      tex.generateMipmaps = false;
      tex.needsUpdate = true;
      return tex;
    }

    /* ---------- 天空白云全屏 quad ---------- */

    const frag = /* glsl */ `
      precision highp float;
      uniform sampler2D uNoise;       // 远山 / 光缕
      uniform sampler2D uCloudBand;   // 低空云海带（横向平铺）
      uniform sampler2D uCloudIslands; // 中景积云岛（横向平铺）
      uniform float uHasBand;
      uniform float uHasIslands;
      uniform vec2  uRes;
      uniform float uTime;
      uniform float uScroll;
      uniform vec2  uMouse;
      varying vec2 vUv;

      void main(){
        vec2 uv = vUv;
        float aspect = uRes.x / uRes.y;
        vec2 suv = vec2(uv.x * aspect, uv.y);

        // 天空：鱼肚白 -> 玉白 -> 宣纸白，朝晖处极淡暖金
        vec3 skyTop = vec3(0.912, 0.918, 0.922);
        vec3 skyMid = vec3(0.955, 0.950, 0.936);
        vec3 skyBot = vec3(0.980, 0.973, 0.953);
        vec3 col = mix(skyBot, skyMid, smoothstep(0.0, 0.55, uv.y));
        col = mix(col, skyTop, smoothstep(0.45, 1.0, uv.y));

        // 太阳（右上）
        vec2 sunPos = vec2(0.74 * aspect, 0.86);
        vec2 toSun = suv - sunPos;
        float sd = length(toSun);
        float ang = atan(toSun.y, toSun.x);
        vec3 sunCol = vec3(0.90, 0.71, 0.36);
        col = mix(col, sunCol * 1.06, clamp(exp(-sd * 1.6), 0.0, 1.0) * 0.10);

        // 远山剪影：极淡中性墨灰脊线（1 次采样）
        float ridge = texture2D(uNoise, vec2(suv.x * 0.22 + 0.13, 0.31)).r;
        float ridgeLine = 0.135 + ridge * 0.055;
        float mtn = smoothstep(ridgeLine + 0.012, ridgeLine - 0.012, uv.y);
        col = mix(col, vec3(0.44, 0.425, 0.40), mtn * 0.32);

        // 金色光缕强度场（1 次采样，云遮蔽在最后统一做）
        float rays = 0.60 + 0.40 * texture2D(uNoise, vec2(ang * 2.2 + 3.7, sd * 2.4 - uTime * 0.03)).r;
        float sunGlow = (exp(-sd * 3.2) * 0.85 + exp(-sd * 1.05) * 0.30) * rays;

        float t = uTime;
        float totalOcc = 0.0;

        /* 层 0：低空云海带（1 次采样，底部 band mask） */
        {
          vec2 bUV;
          bUV.x = suv.x * 0.35 + t * 0.006 + uMouse.x * 0.03;
          bUV.y = uv.y / 0.55 - uScroll * 0.12 + uMouse.y * 0.012;
          vec4 band = texture2D(uCloudBand, bUV);
          float bandMask = smoothstep(0.56, 0.50, uv.y) * smoothstep(-0.06, 0.04, uv.y);
          float a = clamp(band.a * 1.15, 0.0, 1.0) * bandMask * uHasBand;
          col = mix(col, band.rgb, a);
          totalOcc = clamp(totalOcc + a * 0.9, 0.0, 1.0);
        }

        /* 层 1：中景积云岛（1 次采样，zone mask 限中部天空，近层视差更大） */
        {
          vec2 iUV;
          iUV.x = suv.x * 0.30 + t * 0.004 + uMouse.x * 0.06;
          iUV.y = uv.y * 0.5 + 0.25 - uScroll * 0.22 + uMouse.y * 0.025;
          vec4 isl = texture2D(uCloudIslands, iUV);
          float zone = smoothstep(0.10, 0.30, uv.y) * smoothstep(1.05, 0.70, uv.y);
          float a = clamp(isl.a * 1.4, 0.0, 1.0) * zone * uHasIslands;
          col = mix(col, isl.rgb, a);
          totalOcc = clamp(totalOcc + a * 0.85, 0.0, 1.0);
        }

        /* 层 2：高空卷云（噪声拉丝，2 次采样，极淡极慢） */
        {
          vec2 cp = (suv + vec2(uMouse.x * 0.02, uScroll * 0.5)) * vec2(1.0, 2.4)
                  + vec2(t * 0.003, 0.0) + 41.7;
          float ci = texture2D(uNoise, cp).g * 0.62
                   + texture2D(uNoise, cp * vec2(2.1, 1.6) + 0.47).b * 0.38;
          float cir = smoothstep(0.58, 0.88, ci) * smoothstep(0.35, 0.7, uv.y) * 0.26;
          col = mix(col, vec3(0.985, 0.980, 0.962), cir * (1.0 - totalOcc * 0.6));
          totalOcc = clamp(totalOcc + cir * 0.4, 0.0, 1.0);
        }

        // 金色光缕自云上洒下（云隙漏光）
        float occ = 1.0 - totalOcc * 0.6;
        col = mix(col, sunCol, clamp(sunGlow * occ * 1.1, 0.0, 0.60));
        col = mix(col, vec3(0.995, 0.945, 0.83), smoothstep(0.05, 0.024, sd) * occ);

        // 极轻纸色收拢 + 细颗粒
        vec2 vc = uv - 0.5;
        col = mix(col, skyBot, dot(vc, vc) * 0.14);
        float grain = fract(sin(dot(gl_FragCoord.xy + fract(uTime) * 90.0, vec2(12.9898, 78.233))) * 43758.5453) * 0.010;
        col += grain - 0.005;

        gl_FragColor = vec4(col, 1.0);
      }
    `;

    const vert = /* glsl */ `
      varying vec2 vUv;
      void main(){ vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }
    `;

    const uniforms = {
      uNoise: { value: makeNoiseTexture() },
      uCloudBand: { value: null as THREE.Texture | null },
      uCloudIslands: { value: null as THREE.Texture | null },
      uHasBand: { value: 0 },
      uHasIslands: { value: 0 },
      uRes: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },
      uTime: { value: 0 },
      uScroll: { value: 0 },
      uMouse: { value: new THREE.Vector2(0, 0) },
      uPixelRatio: { value: effRatio },
    };

    const scene = new THREE.Scene();
    // 正交相机供 3D 灵玉使用；全屏 quad 与粒子的 shader 输出 clip 坐标，不吃相机矩阵
    const aspect0 = window.innerWidth / window.innerHeight;
    const camera = new THREE.OrthographicCamera(-aspect0, aspect0, 1, -1, 0.1, 10);
    camera.position.z = 5;
    const quad = new THREE.Mesh(
      new THREE.PlaneGeometry(2, 2),
      new THREE.ShaderMaterial({ vertexShader: vert, fragmentShader: frag, uniforms, depthWrite: false })
    );
    quad.frustumCulled = false;
    scene.add(quad);

    /* ---------- 云朵纹理异步加载（404 时保持 uHas=0，优雅降级为无云天空） ---------- */

    const loader = new THREE.TextureLoader();
    function loadCloud(url: string, assign: (t: THREE.Texture) => void) {
      loader.load(
        url,
        (tex) => {
          tex.wrapS = THREE.RepeatWrapping;
          tex.wrapT = THREE.ClampToEdgeWrapping;
          tex.magFilter = THREE.LinearFilter;
          tex.minFilter = THREE.LinearMipmapLinearFilter;
          tex.generateMipmaps = true;
          assign(tex);
          if (reduced) renderFrame(12.0); // 静止模式下纹理就绪后补渲一帧
        },
        undefined,
        () => { /* 加载失败：保持该层关闭，不刷屏 */ }
      );
    }
    loadCloud('/images/cloud-band.png', (tex) => {
      uniforms.uCloudBand.value = tex;
      uniforms.uHasBand.value = 1;
    });
    loadCloud('/images/cloud-islands.png', (tex) => {
      uniforms.uCloudIslands.value = tex;
      uniforms.uHasIslands.value = 1;
    });

    /* ---------- 灵光羽屑粒子（墨银 + 金双色） ---------- */

    const COUNT = 200;
    const pos = new Float32Array(COUNT * 3);
    const seed = new Float32Array(COUNT);
    for (let i = 0; i < COUNT; i++) {
      pos[i * 3] = (Math.random() * 2 - 1) * 1.6;
      pos[i * 3 + 1] = Math.random() * 2 - 1;
      pos[i * 3 + 2] = 0;
      seed[i] = Math.random();
    }
    const pGeo = new THREE.BufferGeometry();
    pGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    pGeo.setAttribute('aSeed', new THREE.BufferAttribute(seed, 1));

    const pMat = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      blending: THREE.NormalBlending,
      uniforms: { uTime: uniforms.uTime, uPixelRatio: uniforms.uPixelRatio, uScroll: uniforms.uScroll },
      vertexShader: /* glsl */ `
        attribute float aSeed;
        uniform float uTime;
        uniform float uPixelRatio;
        uniform float uScroll;
        varying float vTw;
        varying float vSeed;
        void main(){
          vec3 p = position;
          float speed = 0.015 + aSeed * 0.03;
          p.y = mod(p.y + uTime * speed + 1.0, 2.0) - 1.0;
          p.x += sin(uTime * 0.12 + aSeed * 40.0) * 0.05;
          p.y -= uScroll * (0.16 + aSeed * 0.35);
          vTw = 0.45 + 0.55 * sin(uTime * (0.8 + aSeed * 2.6) + aSeed * 20.0);
          vSeed = aSeed;
          gl_Position = vec4(p.xy, 0.0, 1.0);
          gl_PointSize = (2.2 + aSeed * 3.4) * uPixelRatio * (0.7 + vTw * 0.6);
        }
      `,
      fragmentShader: /* glsl */ `
        precision mediump float;
        varying float vTw;
        varying float vSeed;
        void main(){
          vec2 c = gl_PointCoord - 0.5;
          float d = length(c);
          float a = smoothstep(0.5, 0.05, d) * vTw * 0.68;
          vec3 gold = vec3(0.63, 0.47, 0.16);
          vec3 silver = vec3(0.42, 0.415, 0.40);
          gl_FragColor = vec4(mix(silver, gold, step(0.5, vSeed)), a);
        }
      `,
    });
    const points = new THREE.Points(pGeo, pMat);
    points.frustumCulled = false;
    scene.add(points);

    /* ---------- 悬浮灵玉（3D 光影材质层） ---------- */

    // 光照：与 shader 太阳同向的暖金平行光 + 宣纸白/暖灰半球天光，无阴影贴图
    const sunLight = new THREE.DirectionalLight(0xf2dcae, 1.4);
    sunLight.position.set(3, 4, 5);
    scene.add(sunLight);
    scene.add(new THREE.HemisphereLight(0xfaf8f3, 0x8a8276, 0.9));

    const jadeGeos = [
      new THREE.IcosahedronGeometry(1, 0),
      new THREE.OctahedronGeometry(1, 0),
      new THREE.DodecahedronGeometry(1, 0),
    ];
    // 分布在视口四周与中空区，避开中央文字区（椭圆 x±0.45 / y±0.35）；z 分层，近大近快
    const jadeSpecs = [
      { x: -0.62, y: 0.62, z: 1.5, r: 0.062, g: 0, sp: 0.50, ph: 0.0 },
      { x: 0.66, y: 0.44, z: 0.5, r: 0.048, g: 1, sp: 0.65, ph: 1.3 },
      { x: -0.50, y: -0.56, z: 2.0, r: 0.068, g: 2, sp: 0.42, ph: 2.4 },
      { x: 0.56, y: -0.62, z: 1.0, r: 0.044, g: 0, sp: 0.70, ph: 3.6 },
      { x: -0.80, y: -0.02, z: -0.5, r: 0.036, g: 1, sp: 0.55, ph: 4.4 },
      { x: 0.84, y: 0.06, z: 1.8, r: 0.058, g: 2, sp: 0.48, ph: 5.2 },
    ];
    const jadeXScale = Math.min(Math.max(aspect0, 1.0), 1.9);
    const jades = jadeSpecs.map((s) => {
      const mat = new THREE.MeshPhysicalMaterial({
        color: 0xf5efe0,
        roughness: 0.3 + (s.ph % 1) * 0.1,
        clearcoat: 0.6,
        clearcoatRoughness: 0.4,
        emissive: 0xf5efe0,
        emissiveIntensity: 0.05,
      });
      const mesh = new THREE.Mesh(jadeGeos[s.g], mat);
      mesh.scale.setScalar(s.r);
      mesh.position.set(s.x * jadeXScale, s.y, s.z);
      mesh.rotation.set(s.ph, s.ph * 1.7, 0);
      scene.add(mesh);
      return { mesh, ...s, baseX: s.x * jadeXScale, baseY: s.y };
    });

    /* ---------- 交互与渲染循环（30fps 节流） ---------- */

    const state = { scroll: 0 };
    const mouseTarget = { x: 0, y: 0 };
    const mouseCur = { x: 0, y: 0 };
    let rafId = 0;
    let frame = 0;
    const clock = new THREE.Clock();

    function renderFrame(time: number) {
      uniforms.uTime.value = time;
      uniforms.uScroll.value += (state.scroll - uniforms.uScroll.value) * 0.06;
      mouseCur.x += (mouseTarget.x - mouseCur.x) * 0.04;
      mouseCur.y += (mouseTarget.y - mouseCur.y) * 0.04;
      uniforms.uMouse.value.set(mouseCur.x, mouseCur.y);
      // 灵玉：缓慢浮动 + 微旋转 + 按深度的滚动/鼠标视差（近处幅度大）
      const sc = uniforms.uScroll.value;
      for (const j of jades) {
        const depth = 0.25 + j.z * 0.18;
        j.mesh.position.y = j.baseY + Math.sin(time * j.sp + j.ph) * 0.04
          + sc * depth + mouseCur.y * 0.05;
        j.mesh.position.x = j.baseX + mouseCur.x * (0.04 + j.z * 0.03);
        j.mesh.rotation.x = j.ph + time * 0.12 * j.sp;
        j.mesh.rotation.y = j.ph * 1.7 + time * 0.09 * j.sp;
      }
      renderer.render(scene, camera);
    }

    function loop() {
      frame++;
      if (frame % 2 === 0) renderFrame(clock.getElapsedTime());
      rafId = requestAnimationFrame(loop);
    }

    function onResize() {
      renderer.setSize(window.innerWidth, window.innerHeight, false);
      uniforms.uRes.value.set(window.innerWidth, window.innerHeight);
      const a = window.innerWidth / window.innerHeight;
      camera.left = -a;
      camera.right = a;
      camera.updateProjectionMatrix();
      if (reduced) renderFrame(12.0);
    }
    window.addEventListener('resize', onResize);

    if (reduced) {
      renderFrame(12.0); // 先渲无云天空，纹理就绪后回调补渲
    } else {
      gsap.registerPlugin(ScrollTrigger);
      gsap.to(state, {
        scroll: 1,
        ease: 'none',
        scrollTrigger: { start: 0, end: 'max', scrub: 0.8 },
      });
      window.addEventListener('mousemove', (e) => {
        mouseTarget.x = (e.clientX / window.innerWidth) * 2 - 1;
        mouseTarget.y = -((e.clientY / window.innerHeight) * 2 - 1);
      }, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(rafId);
        } else {
          clock.getDelta();
          loop();
        }
      });
      loop();
    }
  }
</script>
