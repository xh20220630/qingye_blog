---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fmtDate, fmtYearMonth } from '../lib/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groups = new Map<string, typeof posts>();
for (const p of posts) {
  const key = fmtYearMonth(p.data.pubDate);
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(p);
}
---
<BaseLayout title="归档" description="青野山房岁月归档：以年月为序，回看每一卷玉简的刊刻时刻。">
  <div class="container">
    <div class="deco-strip" aria-hidden="true">
      <img src="/images/ink-mountains.jpg" alt="" loading="lazy" />
    </div>
    <header class="page-head" style="padding-top: 2.2rem;">
      <h1 class="page-title">岁月归档</h1>
      <p class="page-desc">以年月为序，回看山房中每一卷玉简的刊刻时刻。</p>
    </header>
    {[...groups.entries()].map(([ym, list]) => (
      <section class="arch-group">
        <h2 class="arch-ym">{ym}</h2>
        <ul class="arch-list">
          {list.map((p) => (
            <li>
              <span class="arch-day">{p.data.pubDate.getDate()} 日</span>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
