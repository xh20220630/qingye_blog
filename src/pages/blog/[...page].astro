---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fmtDate } from '../../lib/format';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 8 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---
<BaseLayout title="全部文章" description="青野山房藏经阁：全部玉简书卷，按时刻倒序陈列。">
  <div class="container">
    <div class="deco-strip" aria-hidden="true">
      <img src="/images/ink-mountains.jpg" alt="" loading="lazy" />
    </div>
    <header class="page-head" style="padding-top: 2.2rem;">
      <h1 class="page-title">藏经阁</h1>
      <p class="page-desc">阁中玉简 {page.total} 卷，按刊刻时刻倒序陈列。第 {page.currentPage} 页，共 {page.lastPage} 页。</p>
    </header>

    <div class="post-rows">
      {page.data.map((p) => (
        <div class="post-row">
          <span class="post-row-date">{fmtDate(p.data.pubDate)}</span>
          <div>
            <a class="post-row-title" href={`/blog/${p.id}/`}>{p.data.title}</a>
            <p class="post-row-desc">{p.data.description}</p>
          </div>
          <span class="post-row-tags">
            {p.data.tags.slice(0, 2).map((t) => <a class="tag-chip" href={`/tags/${t}/`}>{t}</a>)}
          </span>
        </div>
      ))}
    </div>

    {page.lastPage > 1 && (
      <nav class="pagination" aria-label="分页">
        {page.url.prev ? <a href={page.url.prev}>上一页</a> : <span></span>}
        <span class="page-cur">{page.currentPage} / {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next}>下一页</a> : <span></span>}
      </nav>
    )}
  </div>
</BaseLayout>
