---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImmortalMist from '../components/ImmortalMist.astro';
import FloatTools from '../components/FloatTools.astro';
import '../styles/global.css';
import '../styles/world.css';
import '../styles/community.css';
import { siteConfig } from '../config';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogType?: string;
  ogImage?: string;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle,
  ogType = 'website',
  ogImage = '/images/xianxia/realm.webp',
  jsonld,
  noindex = false,
} = Astro.props;

const site = siteConfig.name;
const fullTitle = title === site ? `${site} · ${siteConfig.subtitle}` : `${title} · ${site}`;
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImageUrl = new URL(ogImage, origin).href;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#dce7ed" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={ogTitle ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="alternate" type="application/rss+xml" title="青野山房 RSS" href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="青野山房 JSON Feed" href="/feed.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23b3452e'/%3E%3Ctext x='16' y='23' font-size='18' text-anchor='middle' fill='%23f7f1e8' font-family='KaiTi,serif'%3E青%3C/text%3E%3C/svg%3E" />
    <script is:inline>
      (function () {
        if (window.self !== window.top) document.documentElement.dataset.embedded = 'true';
        try {
          var fs = localStorage.getItem('qy_font_size');
          if (fs === 's' || fs === 'm' || fs === 'l') document.documentElement.dataset.font = fs;
          if (localStorage.getItem('qy_motion') === 'off') document.documentElement.dataset.motion = 'off';
        } catch (e) {}
      })();
    </script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')} />}
  </head>
  <body class:list={[isHome ? 'site-home' : 'site-interior']}>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <ImmortalMist />
    {!isHome && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {!isHome && <Footer />}
    {!isHome && <FloatTools />}
<script>
  if (window.self !== window.top) {
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest('a');
      if (!link || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const url = new URL(link.href, location.href);
      if (url.origin === location.origin && url.pathname === '/') {
        event.preventDefault();
        window.parent.postMessage({ type: 'realm:close-reader' }, location.origin);
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !event.defaultPrevented && !document.querySelector('dialog[open], .pei-panel.is-open')) {
        window.parent.postMessage({ type: 'realm:close-reader' }, location.origin);
      }
    });
  }
</script>
  </body>
</html>
